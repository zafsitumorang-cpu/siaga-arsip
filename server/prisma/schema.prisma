generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusArsip {
  MENUNGGU
  TERVERIFIKASI
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  role         String         @default("ADMIN")
  createdAt    DateTime       @default(now())
  arsipDibuat  Arsip[]        @relation("PembuatArsip")
  arsipDiverif Arsip[]        @relation("VerifikatorArsip")
  riwayat      RiwayatArsip[]
}

model Subbagian {
  id    Int     @id @default(autoincrement())
  nama  String  @unique
  arsip Arsip[]
}

model Arsip {
  id             Int         @id @default(autoincrement())
  nomor          String?
  judul          String
  subbagianId    Int
  subbagian      Subbagian   @relation(fields: [subbagianId], references: [id])
  tanggalDokumen DateTime?
  status         StatusArsip @default(MENUNGGU)
  isDigital      Boolean     @default(false)
  fileNama       String?
  filePath       String?
  createdAt      DateTime    @default(now())
  createdById    Int?
  createdBy      User?       @relation("PembuatArsip", fields: [createdById], references: [id])
  verifiedById   Int?
  verifiedBy     User?       @relation("VerifikatorArsip", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  /// Soft delete: arsip disembunyikan dari daftar, tetap tersimpan untuk audit.
  deletedAt      DateTime?
  riwayat        RiwayatArsip[]

  @@index([status])
  @@index([subbagianId])
  @@index([deletedAt])
}

/// Jejak audit: siapa melakukan apa, kapan. Nilai jual utama sistem kearsipan.
model RiwayatArsip {
  id         Int      @id @default(autoincrement())
  arsipId    Int
  arsip      Arsip    @relation(fields: [arsipId], references: [id], onDelete: Cascade)
  aksi       String
  keterangan String?
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  username   String?
  createdAt  DateTime @default(now())

  @@index([arsipId])
}
